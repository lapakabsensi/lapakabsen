rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuper() {
      return request.auth != null && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }
    function adminOfT(t) {
      return request.auth != null
        && get(/databases/$(database)/documents/tenants/$(t)/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ===== Super Admin (penyedia layanan) =====
    // Akun super admin hidup di koleksi superadmins (bukan di data pelanggan), jadi tidak pernah muncul di daftar karyawan pelanggan.
    match /superadmins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if isSuper();
      allow create: if request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/superMeta/init);   // hanya sekali: super admin pertama
      allow update, delete: if false;
    }
    // alias kode pelanggan (link yang mudah dibaca): siapa pun boleh membaca satu alias, hanya super admin yang boleh mengubah
    match /tenantAlias/{slug} {
      allow get: if true;
      allow write: if isSuper();
    }
    match /superMeta/{id} {
      allow get: if id == 'init' || id == 'brand' || request.auth != null;
      allow create: if id == 'init' && request.auth != null && !exists(/databases/$(database)/documents/superMeta/init)
                    && existsAfter(/databases/$(database)/documents/superadmins/$(request.auth.uid));
      allow write: if isSuper() && id != 'init';
    }

    // ===== Pelanggan & lisensi =====
    // Dokumen pelanggan boleh dibaca siapa pun yang tahu kodenya (nama, kuota, status; dipakai halaman login). Daftar semua pelanggan hanya super admin.
    match /tenants/{tid} {
      allow get: if true;
      allow list: if isSuper();
      allow create, delete: if isSuper();
      allow update: if isSuper()
        || (adminOfT(tid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'lastUid'])
            && (
              // tambah kursi: dokumen users baru dibuat dalam batch yang sama
              (request.resource.data.used == resource.data.used + 1 && request.resource.data.used <= resource.data.quota
                && !exists(/databases/$(database)/documents/tenants/$(tid)/users/$(request.resource.data.lastUid))
                && existsAfter(/databases/$(database)/documents/tenants/$(tid)/users/$(request.resource.data.lastUid)))
              // lepas kursi: dokumen users dihapus dalam batch yang sama
              || (request.resource.data.used == resource.data.used - 1 && resource.data.used > 0
                && exists(/databases/$(database)/documents/tenants/$(tid)/users/$(request.resource.data.lastUid))
                && !existsAfter(/databases/$(database)/documents/tenants/$(tid)/users/$(request.resource.data.lastUid)))))
        || (adminOfT(tid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quota', 'lastLic', 'licUntil'])
            // kuota hanya naik sebesar jumlah lisensi yang token-nya baru saja dimasukkan (status terbit -> aktif dalam batch yang sama)
            && get(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.tid == tid
            && get(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.status == 'terbit'
            && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.status == 'aktif'
            && request.resource.data.quota == resource.data.quota + get(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.qty
            // licUntil (batas akses pegawai) = yang paling akhir antara nilai lama dan masa berlaku lisensi yang baru diaktifkan
            && request.resource.data.get('licUntil', timestamp.date(1970, 1, 1)) ==
               (resource.data.get('licUntil', timestamp.date(1970, 1, 1)) >= getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.expiresAt
                 ? resource.data.get('licUntil', timestamp.date(1970, 1, 1))
                 : getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.expiresAt))
        || (adminOfT(tid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quota', 'lastLic'])
            // token yang masa berlakunya sudah lewat: kuota turun sebesar jumlah lisensi itu (aktif -> kedaluwarsa dalam batch yang sama)
            && get(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.tid == tid
            && get(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.status == 'aktif'
            && get(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.expiresAt < request.time
            && getAfter(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.status == 'kedaluwarsa'
            && request.resource.data.quota == resource.data.quota - get(/databases/$(database)/documents/licenses/$(request.resource.data.lastLic)).data.qty
            && request.resource.data.quota >= 0);

    // pelanggan aktif + pengguna login. Super admin (akun di koleksi superadmins) boleh membaca & menulis semua data pelanggan.
    // Lisensi: akun pegawai / HR hanya diterima selama tenants/{tid}.licUntil masih di masa depan (diisi Super Admin & saat admin mengaktifkan token).
    // Tidak ada lisensi aktif / sudah berakhir / dinonaktifkan / dihapus => licUntil sudah lewat => ditolak otomatis, tanpa menunggu aplikasi.
    // Admin pelanggan dikecualikan supaya tetap bisa masuk ke menu Lisensi untuk memperpanjang.
    function licOk() {
      return get(/databases/$(database)/documents/tenants/$(tid)).data.get('licUntil', timestamp.date(1970, 1, 1)) > request.time;
    }
    function tok() {
      return request.auth != null
        && (isSuper() || (get(/databases/$(database)/documents/tenants/$(tid)).data.status == 'aktif'
            && (licOk()
                || get(/databases/$(database)/documents/tenants/$(tid)/users/$(request.auth.uid)).data.role == 'admin')));
    }
    function roleIs(r) {
      return tok() && get(/databases/$(database)/documents/tenants/$(tid)/users/$(request.auth.uid)).data.role == r;
    }
    function isAdmin() { return isSuper() || roleIs('admin'); }
    function isHR() { return roleIs('hr'); }

    // karyawan hanya boleh ubah foto profil, tandai password sudah diganti,
    // dan rekam wajah SEKALI (kalau data wajah sudah ada, hanya admin yang bisa reset/ubah)
    function selfUpdate(uid) {
      let ch = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth.uid == uid
        && ch.hasOnly(['avatar', 'pwDone', 'faceDesc', 'facePhoto', 'faceAt', 'slipPin'])
        && (!ch.hasAny(['pwDone']) || request.resource.data.pwDone == true)
        && (!ch.hasAny(['faceDesc', 'facePhoto', 'faceAt']) || !('faceDesc' in resource.data));
    }

    // absensi karyawan: hanya boleh MEMBUAT dokumen hari itu (absen masuk) dan MENGISI kolom absen berikutnya yang masih kosong.
    // Data yang sudah tercatat (jam, status, foto) tidak bisa diubah karyawan; perbaikan hanya lewat persetujuan (HR/admin).
    function ownAtt(id) {
      return tok() && id.matches(request.auth.uid + '_.*') && request.resource.data.uid == request.auth.uid;
    }
    function attEmpty(f) { return !(f in resource.data) || resource.data[f] == null; }
    // ---- Waktu server: jam absen tidak bisa dipalsukan lewat jam HP ----
    // Karyawan wajib mengirim inAt/midAt/aftAt/outAt = serverTimestamp (== request.time). Jam teks (in/mid/aft/out) dan tanggal
    // harus cocok dengan waktu server (selisih maks. 3 menit) pada zona waktu perusahaan (settings/work.tz, default 7 = WIB).
    function workDoc() {
      return exists(/databases/$(database)/documents/tenants/$(tid)/settings/work)
        ? get(/databases/$(database)/documents/tenants/$(tid)/settings/work).data : {};
    }
    function tzHours() {
      let z = workDoc().get('tz', 7);
      return (z is int && z >= -12 && z <= 14) ? z : 7;
    }
    function localNow() { return request.time + duration.value(tzHours(), 'h'); }
    function two(n) { return (n < 10 ? '0' : '') + string(n); }
    function ymdOf(t) { return string(t.year()) + '-' + two(t.month()) + '-' + two(t.day()); }
    function hmOf(t) { return two(t.hours()) + ':' + two(t.minutes()); }
    function nearNow(s) {
      let n = localNow();
      return s is string && s in [
        hmOf(n - duration.value(3, 'm')), hmOf(n - duration.value(2, 'm')), hmOf(n - duration.value(1, 'm')), hmOf(n),
        hmOf(n + duration.value(1, 'm')), hmOf(n + duration.value(2, 'm')), hmOf(n + duration.value(3, 'm'))];
    }
    function userDoc() { return get(/databases/$(database)/documents/tenants/$(tid)/users/$(request.auth.uid)).data; }
    // Jadwal shift bergilir: dokumen schedules/{uid}_{tanggal} milik karyawan untuk tanggal server hari ini menimpa jam default
    // (jadwal "off" / tidak ada jadwal -> pakai jam khusus karyawan, lalu Jadwal Kerja)
    function tmOk(s) { return s is string && s.matches('[0-2][0-9]:[0-5][0-9]'); }
    function schPath() {
      return /databases/$(database)/documents/tenants/$(tid)/schedules/$(request.auth.uid + '_' + ymdOf(localNow()));
    }
    function schDoc() { return exists(schPath()) ? get(schPath()).data : {}; }
    function shiftInOf() {
      let sc = schDoc().get('in', '');
      let si = userDoc().get('shiftIn', '');
      return (schDoc().get('off', false) != true && tmOk(sc)) ? sc : (tmOk(si) ? si : workDoc().get('in', '09:00'));
    }
    function tolOf() {
      let st = schDoc().get('tol', null);
      let ut = userDoc().get('tol', null);
      let r = (schDoc().get('off', false) != true && st is number) ? st : (ut is number) ? ut : workDoc().get('tol', 0);
      return (r is int && r >= 0 && r <= 600) ? r : 0;
    }
    // status "normal" hanya sah kalau menurut jam SERVER memang belum lewat jam masuk + toleransi ("abnormal" selalu boleh)
    function onTime() { return hmOf(localNow() - duration.value(tolOf(), 'm')) <= shiftInOf(); }
    // syarat minimum bukti wajah: ada foto dan jarak wajah <= FACE_MAX (0.6, samakan dengan extra.js).
    // CATATAN: ini hanya pagar tambahan, bukan bukti. Pencocokan wajah & GPS yang sebenarnya tetap dikerjakan di browser.
    function faceOk(k) {
      let d = request.resource.data;
      return d.get(k + 'Dist', null) is number && d[k + 'Dist'] <= 0.6
        && d.get(k + 'Photo', '') is string && d[k + 'Photo'].size() > 200;
    }
    function inStepOk(d) {
      return d.get('inAt', null) == request.time && d.date == ymdOf(localNow())
        && nearNow(d.get('in', null)) && (d.status == 'abnormal' || onTime()) && faceOk('in');
    }
    function stepOk(k) {
      let d = request.resource.data;
      return nearNow(d.get(k, null)) && d.get(k + 'At', null) == request.time && faceOk(k)
        && (resource.data.get('date', '') == ymdOf(localNow())
            || (k == 'out' && resource.data.get('date', '') == ymdOf(localNow() - duration.value(1, 'd'))));
    }

    function selfAttCreate(id) {
      let d = request.resource.data;
      return ownAtt(id) && id == request.auth.uid + '_' + d.date
        && d.keys().hasOnly(['uid', 'date', 'in', 'out', 'mid', 'aft', 'inLoc', 'inPhoto', 'inDist', 'inAt', 'status'])
        && d.keys().hasAll(['uid', 'date', 'in', 'status', 'inAt'])
        && d.status in ['normal', 'abnormal']
        && d.get('out', null) == null && d.get('mid', null) == null && d.get('aft', null) == null
        && inStepOk(d);
    }
    function selfAttUpdate(id) {
      let ch = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return ownAtt(id) && (
           (ch.hasOnly(['in', 'inLoc', 'inPhoto', 'inDist', 'inAt', 'status', 'out', 'mid', 'aft']) && attEmpty('in')
              && d.get('out', null) == null && d.get('mid', null) == null && d.get('aft', null) == null && inStepOk(d))
        || (ch.hasOnly(['mid', 'midLoc', 'midPhoto', 'midDist', 'midAt']) && attEmpty('mid') && stepOk('mid'))
        || (ch.hasOnly(['aft', 'aftLoc', 'aftPhoto', 'aftDist', 'aftAt']) && attEmpty('aft') && stepOk('aft'))
        || (ch.hasOnly(['out', 'outLoc', 'outPhoto', 'outDist', 'outAt']) && attEmpty('out') && stepOk('out')));
    }

    // atasan / HR yang ditunjuk hanya boleh memutuskan pengajuan pada gilirannya
    // dan hanya mengubah field status, step, log, finalAt
    // atasan bisa lebih dari satu (atasanIds). Mode 'all' = berurutan sesuai urutan daftar (aIdx), mode 'any' = salah satu atasan cukup.
    function atasanTurn(r) {
      let ids = r.get('atasanIds', [r.get('atasanId', '')]);
      return (r.get('atasanMode', 'any') == 'all' && ids.size() > 1)
        ? ids[r.get('aIdx', 0)] == request.auth.uid
        : request.auth.uid in ids;
    }
    function approverUpdate() {
      let r = resource.data;
      return tok() && r.status == 'menunggu'
        && request.resource.data.diff(r).affectedKeys().hasOnly(['status', 'step', 'log', 'finalAt', 'aIdx'])
        && ((r.step == 'atasan' && atasanTurn(r))
         || (r.step == 'hr' && r.hrId == request.auth.uid));
    }

    // ---- Kursi lisensi (kuota akun) ----
    // Membuat akun karyawan = dokumen users (seat:true) + tenants/{tid}.used naik tepat 1 DALAM BATCH YANG SAMA, dengan lastUid = uid akun baru
    // dan used tidak melebihi quota. Menghapus akun berkursi = dokumen users dihapus + used turun tepat 1 (lastUid = uid yang dihapus).
    // Aturan di dokumen tenants (di atas) memastikan pasangannya: used hanya bisa berubah bersama pembuatan/penghapusan dokumen users itu.
    function tenantPath() { return /databases/$(database)/documents/tenants/$(tid); }
    function seatNew(uid) {
      let a = getAfter(tenantPath()).data;
      let b = get(tenantPath()).data;
      return request.resource.data.get('seat', false) == true
        && a.get('lastUid', '') == uid
        && a.used == b.used + 1
        && a.used <= b.quota;
    }
    function seatFree(uid) {
      let a = getAfter(tenantPath()).data;
      let b = get(tenantPath()).data;
      return a.get('lastUid', '') == uid
        && b.used > 0
        && a.used == b.used - 1;
    }

    match /users/{uid} {
      // HR boleh membaca daftar karyawan (untuk menu Struktur)
      allow read: if tok() && (request.auth.uid == uid || isAdmin() || isHR());
      // admin pertama dibuat Super Admin. Admin pelanggan hanya bisa menambah akun lewat kursi lisensi.
      allow create: if isSuper() || (isAdmin() && seatNew(uid));
      allow update: if isSuper()
                    || (isAdmin() && request.resource.data.get('seat', false) == resource.data.get('seat', false))
                    || selfUpdate(uid);
      allow delete: if isSuper() || (isAdmin() && (resource.data.get('seat', false) != true || seatFree(uid)));
    }
    match /settings/{id} {
      allow get: if id == 'company' || tok();
      allow list: if tok();
      allow write: if isAdmin();
    }
    match /attendance/{id} {
      // resource == null: membaca dokumen hari ini yang belum ada (absen pertama) harus diizinkan, kalau tidak muncul "Missing or insufficient permissions"
      // HR ikut boleh membaca: saat menyetujui "Absensi Lapangan" sistem perlu membaca dokumen absen hari itu sebelum mengisi kolom yang kosong
      allow read: if tok() && (isAdmin() || isHR() || resource == null || resource.data.uid == request.auth.uid);
      // HR boleh menulis absensi karena menyetujui "Perbaikan Absensi" sebagai persetujuan terakhir
      allow create: if isAdmin() || isHR() || selfAttCreate(id);
      allow update: if isAdmin() || isHR() || selfAttUpdate(id);
      allow delete: if isAdmin();
    }
    match /requests/{id} {
      allow read: if tok() && (resource.data.uid == request.auth.uid
                    || resource.data.atasanId == request.auth.uid
                    || request.auth.uid in resource.data.get('atasanIds', [])
                    || resource.data.hrId == request.auth.uid
                    || isAdmin());
      allow create: if tok() && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'menunggu'
                    && (request.resource.data.get('type','') != 'cuti'
                        || (request.resource.data.get('hari', 1) is int && request.resource.data.get('hari', 1) >= 1));
      allow update: if isAdmin() || approverUpdate();
      allow delete: if isAdmin();
    }
    // salinan password tiap akun untuk menu admin "Password".
    // Hanya admin yang boleh membaca. Pemilik akun hanya boleh menulis salinan miliknya sendiri
    // (dipanggil saat login / ganti password), tidak boleh membaca atau mengubah milik orang lain.
    match /credentials/{uid} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        || (tok() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['pw', 'email', 'updatedAt', 'by'])
            && request.resource.data.pw is string && request.resource.data.pw.size() >= 6);
      allow delete: if isAdmin();
    }
    // permintaan lupa password dari halaman login (belum login). Id dokumen = email huruf kecil, sehingga satu email hanya satu permintaan.
    // Siapa pun boleh MEMBUAT (bentuk dibatasi) dan membaca satu dokumen; hanya admin yang boleh melihat daftar, mengubah, dan menghapus.
    match /resetReq/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email', 'at', 'status'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && id == request.resource.data.email && id == id.lower()
        && request.resource.data.status == 'menunggu' && request.resource.data.at is number;
      allow update, delete: if isAdmin();
    }
    // jadwal shift: admin mengatur, karyawan hanya membaca miliknya, HR boleh membaca semua (perlu saat menyetujui absen lapangan)
    match /schedules/{id} {
      allow read: if tok() && (isAdmin() || isHR() || resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    // riwayat kursi lisensi: siapa akun karyawan yang memakai lisensi mana (tambah / hapus). Admin boleh membaca & menambah entri atas namanya,
    // entri tidak bisa diubah. Dihapus hanya oleh super admin (saat pelanggan dihapus).
    match /seatLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'role', 'action', 'licId', 'ts', 'by', 'byName'])
        && request.resource.data.action in ['tambah', 'hapus', 'pindah']
        && request.resource.data.ts == request.time
        && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isSuper();
    }
    match /payslips/{id} {
      allow read: if tok() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    // audit log (siapa mengubah apa): semua akun yang login boleh MENAMBAH entri atas namanya sendiri (waktu = waktu server),
    // hanya admin yang boleh membaca, dan entri tidak bisa diubah / dihapus dari aplikasi.
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if tok()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.at is number
        && request.resource.data.action in ['create', 'update', 'set', 'delete', 'batch', 'export']
        && request.resource.data.keys().hasOnly(['at', 'ts', 'uid', 'name', 'role', 'action', 'col', 'docId', 'label', 'changes', 'items', 'count', 'note']);
      allow update: if false;
      allow delete: if isSuper();   // hanya super admin, saat menghapus pelanggan
    }
    }

    // permintaan lisensi: admin pelanggan membuat (harga dikunci ke harga pelanggan), super admin menerbitkan token / menolak,
    // admin mengaktifkan dengan memasukkan token yang benar.
    match /licenses/{id} {
      allow read: if isSuper() || (request.auth != null && adminOfT(resource.data.tid));
      allow create: if isSuper()   // super admin: pemulihan dari file backup
        || (request.auth != null && adminOfT(request.resource.data.tid)
        && request.resource.data.keys().hasOnly(['tid', 'tname', 'qty', 'price', 'months', 'total', 'status', 'ts', 'by', 'byName', 'kind', 'ref'])
        // permintaan PERPANJANGAN: kind = 'perpanjang' dan ref = lisensi milik pelanggan yang sama (tanpa token baru; Super Admin yang menyetujui)
        && (!('kind' in request.resource.data) || (request.resource.data.kind == 'perpanjang' && request.resource.data.ref is string
            && get(/databases/$(database)/documents/licenses/$(request.resource.data.ref)).data.tid == request.resource.data.tid))
        && request.resource.data.status == 'menunggu' && request.resource.data.by == request.auth.uid
        && request.resource.data.ts == request.time
        && request.resource.data.qty is int && request.resource.data.qty >= 1 && request.resource.data.qty <= 1000
        && request.resource.data.price == get(/databases/$(database)/documents/tenants/$(request.resource.data.tid)).data.price
        && request.resource.data.get('months', 1) is int && request.resource.data.get('months', 1) >= 1 && request.resource.data.get('months', 1) <= 24
        && request.resource.data.total == request.resource.data.qty * request.resource.data.price * request.resource.data.get('months', 1));
      allow update: if isSuper()
        // admin pelanggan mengunggah bukti pembayaran (gambar kecil, disimpan sebagai teks) selama permintaan masih menunggu
        || (request.auth != null && adminOfT(resource.data.tid) && resource.data.status == 'menunggu'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proof', 'proofAt'])
            && request.resource.data.proof is string && request.resource.data.proof.size() < 700000
            && request.resource.data.proofAt == request.time)
        || (request.auth != null && adminOfT(resource.data.tid) && resource.data.status == 'terbit'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'tokenInput', 'activatedAt', 'expiresAt'])
            && request.resource.data.status == 'aktif' && request.resource.data.tokenInput == resource.data.token
            // masa berlaku = jumlah bulan yang ditetapkan Super Admin, dihitung sejak token dimasukkan (toleransi 2 hari untuk selisih jam perangkat)
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt > request.time + duration.value(28 * resource.data.get('months', 1) - 2, 'd')
            && request.resource.data.expiresAt < request.time + duration.value(31 * resource.data.get('months', 1) + 2, 'd'))
        // token sudah lewat masa berlakunya: admin pelanggan menandainya kedaluwarsa (bersamaan dengan pencabutan kuota di dokumen pelanggan)
        || (request.auth != null && adminOfT(resource.data.tid) && resource.data.status == 'aktif'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'kedaluwarsa'
            && resource.data.get('expiresAt', request.time + duration.value(1, 'd')) < request.time);
      allow delete: if isSuper();   // hanya super admin, saat menghapus pelanggan
    }
  }
}
